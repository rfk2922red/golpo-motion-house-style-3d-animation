[
 {
  "i": 0,
  "text": "বাবা চলে গিয়েছিলো এক বর্ষার রাতে।",
  "start": 0,
  "end": 2.4,
  "startFrame": 0,
  "endFrame": 72
 },
 {
  "i": 1,
  "text": "যাওয়ার সময় একটা ছাতাও রেখে যায়নি।",
  "start": 3.16,
  "end": 5.27,
  "startFrame": 95,
  "endFrame": 158
 },
 {
  "i": 2,
  "text": "গ্রামের শেষ মাথায়,",
  "start": 6.02,
  "end": 7.199,
  "startFrame": 181,
  "endFrame": 216
 },
 {
  "i": 2,
  "text": "টিনের চালের একটা ছোটো ঘর।",
  "start": 7.199,
  "end": 8.75,
  "startFrame": 216,
  "endFrame": 262
 },
 {
  "i": 3,
  "text": "সেখানে থাকতো ফাতেমা,",
  "start": 9.54,
  "end": 10.841,
  "startFrame": 286,
  "endFrame": 325
 },
 {
  "i": 3,
  "text": "তার বড় মেয়ে নুসরাত,",
  "start": 10.841,
  "end": 12.208,
  "startFrame": 325,
  "endFrame": 366
 },
 {
  "i": 3,
  "text": "ছেলে রাহাত,",
  "start": 12.208,
  "end": 12.924,
  "startFrame": 366,
  "endFrame": 388
 },
 {
  "i": 3,
  "text": "আর কোলের মেয়ে মিম।",
  "start": 12.924,
  "end": 14.16,
  "startFrame": 388,
  "endFrame": 425
 },
 {
  "i": 4,
  "text": "বাবা চলে যাওয়ার পর,",
  "start": 14.94,
  "end": 16.168,
  "startFrame": 448,
  "endFrame": 485
 },
 {
  "i": 4,
  "text": "সংসারের সব ভার এসে পড়লো মায়ের কাঁধে।",
  "start": 16.168,
  "end": 18.5,
  "startFrame": 485,
  "endFrame": 555
 },
 {
  "i": 5,
  "text": "ভোর হওয়ার আগেই মা উঠে যেতো।",
  "start": 19.27,
  "end": 21.07,
  "startFrame": 578,
  "endFrame": 632
 },
 {
  "i": 6,
  "text": "কখনো ধান ভানতো,",
  "start": 21.82,
  "end": 22.893,
  "startFrame": 655,
  "endFrame": 687
 },
 {
  "i": 6,
  "text": "কখনো পরের বাড়িতে কাজ করতো,",
  "start": 22.893,
  "end": 24.825,
  "startFrame": 687,
  "endFrame": 745
 },
 {
  "i": 6,
  "text": "আর রাতে বসে সেলাই করতো।",
  "start": 24.825,
  "end": 26.47,
  "startFrame": 745,
  "endFrame": 794
 },
 {
  "i": 7,
  "text": "টিনের চাল চুঁইয়ে বৃষ্টির জল পড়লে,",
  "start": 27.18,
  "end": 29.327,
  "startFrame": 815,
  "endFrame": 880
 },
 {
  "i": 7,
  "text": "মা একটা পাতিল পেতে দিতো।",
  "start": 29.327,
  "end": 30.8,
  "startFrame": 880,
  "endFrame": 924
 },
 {
  "i": 8,
  "text": "তিন ভাইবোন,",
  "start": 31.57,
  "end": 32.306,
  "startFrame": 947,
  "endFrame": 969
 },
 {
  "i": 8,
  "text": "সেই জলের টুপটাপ শব্দ শুনতে শুনতে,",
  "start": 32.306,
  "end": 34.513,
  "startFrame": 969,
  "endFrame": 1035
 },
 {
  "i": 8,
  "text": "ঘুমিয়ে পড়তো।",
  "start": 34.513,
  "end": 35.45,
  "startFrame": 1035,
  "endFrame": 1064
 },
 {
  "i": 9,
  "text": "একবার মাসের শেষে,",
  "start": 36.22,
  "end": 37.35,
  "startFrame": 1087,
  "endFrame": 1120
 },
 {
  "i": 9,
  "text": "চাল ফুরিয়ে গেলো।",
  "start": 37.35,
  "end": 38.48,
  "startFrame": 1120,
  "endFrame": 1154
 },
 {
  "i": 10,
  "text": "মা বললো, “আমার খিদে নেই রে।”",
  "start": 39.22,
  "end": 41.31,
  "startFrame": 1177,
  "endFrame": 1239
 },
 {
  "i": 11,
  "text": "তিন জনের প্লেটে ভাত বেড়ে দিয়ে,",
  "start": 42.08,
  "end": 43.81,
  "startFrame": 1262,
  "endFrame": 1314
 },
 {
  "i": 11,
  "text": "নিজে এক গ্লাস পানি খেয়ে শুয়ে পড়লো।",
  "start": 43.81,
  "end": 45.81,
  "startFrame": 1314,
  "endFrame": 1374
 },
 {
  "i": 12,
  "text": "নুসরাত তখন ক্লাস সিক্সে।",
  "start": 46.6,
  "end": 48.24,
  "startFrame": 1398,
  "endFrame": 1447
 },
 {
  "i": 13,
  "text": "সে সবই বুঝলো।",
  "start": 48.99,
  "end": 50.15,
  "startFrame": 1470,
  "endFrame": 1504
 },
 {
  "i": 14,
  "text": "সেদিন রাতে,",
  "start": 50.9,
  "end": 51.664,
  "startFrame": 1527,
  "endFrame": 1550
 },
 {
  "i": 14,
  "text": "সে মনে মনে একটা কথা বললো।",
  "start": 51.664,
  "end": 53.4,
  "startFrame": 1550,
  "endFrame": 1602
 },
 {
  "i": 15,
  "text": "আমি ধীরে ধীরে অনেক বড় হবো একদিন।",
  "start": 54.16,
  "end": 56.41,
  "startFrame": 1625,
  "endFrame": 1692
 },
 {
  "i": 16,
  "text": "মাকে আর কাঁদতে দেবো না।",
  "start": 57.18,
  "end": 58.64,
  "startFrame": 1715,
  "endFrame": 1759
 },
 {
  "i": 17,
  "text": "কুপির আলোতে তিনজন পড়তো,",
  "start": 59.39,
  "end": 61.05,
  "startFrame": 1782,
  "endFrame": 1831
 },
 {
  "i": 17,
  "text": "পাশে বসে মা সেলাই করতো।",
  "start": 61.05,
  "end": 62.64,
  "startFrame": 1831,
  "endFrame": 1879
 },
 {
  "i": 18,
  "text": "মা বেশি পড়েনি,",
  "start": 63.37,
  "end": 64.389,
  "startFrame": 1901,
  "endFrame": 1932
 },
 {
  "i": 18,
  "text": "কিন্তু রোজ জিজ্ঞেস করতো,",
  "start": 64.389,
  "end": 66.021,
  "startFrame": 1932,
  "endFrame": 1981
 },
 {
  "i": 18,
  "text": "আজ কী শিখলি রে?",
  "start": 66.021,
  "end": 67.04,
  "startFrame": 1981,
  "endFrame": 2011
 },
 {
  "i": 19,
  "text": "মায়ের কাছে,",
  "start": 67.77,
  "end": 68.535,
  "startFrame": 2033,
  "endFrame": 2056
 },
 {
  "i": 19,
  "text": "সেই প্রশ্নটাই ছিলো সবচেয়ে বড় ভরসা।",
  "start": 68.535,
  "end": 70.83,
  "startFrame": 2056,
  "endFrame": 2125
 },
 {
  "i": 20,
  "text": "একদিন মা নিজের চুড়ি বেচে,",
  "start": 71.58,
  "end": 73.176,
  "startFrame": 2147,
  "endFrame": 2195
 },
 {
  "i": 20,
  "text": "নুসরাতের কলেজের ফর্ম তুলে দিলো।",
  "start": 73.176,
  "end": 75.08,
  "startFrame": 2195,
  "endFrame": 2252
 },
 {
  "i": 21,
  "text": "নুসরাত শহরে চলে গেলো।",
  "start": 75.84,
  "end": 77.44,
  "startFrame": 2275,
  "endFrame": 2323
 },
 {
  "i": 22,
  "text": "যাওয়ার দিন মা আঁচলের কোণে",
  "start": 78.2,
  "end": 79.757,
  "startFrame": 2346,
  "endFrame": 2393
 },
 {
  "i": 22,
  "text": "বাঁধা কিছু টাকা গুঁজে দিয়ে বললো,",
  "start": 79.757,
  "end": 81.732,
  "startFrame": 2393,
  "endFrame": 2452
 },
 {
  "i": 22,
  "text": "ভালো করে পড়িস মা।",
  "start": 81.732,
  "end": 82.81,
  "startFrame": 2452,
  "endFrame": 2484
 },
 {
  "i": 23,
  "text": "শহরের দিন এত সহজ ছিলো না।",
  "start": 83.55,
  "end": 85.47,
  "startFrame": 2506,
  "endFrame": 2564
 },
 {
  "i": 24,
  "text": "মেসের ছোটো ঘর, ঘরের ভাড়া,",
  "start": 86.25,
  "end": 88.147,
  "startFrame": 2588,
  "endFrame": 2644
 },
 {
  "i": 24,
  "text": "বাসের ভিড়।",
  "start": 88.147,
  "end": 88.95,
  "startFrame": 2644,
  "endFrame": 2668
 },
 {
  "i": 25,
  "text": "নুসরাত টিউশনি করে পড়তো।",
  "start": 89.7,
  "end": 91.53,
  "startFrame": 2691,
  "endFrame": 2746
 },
 {
  "i": 26,
  "text": "রাহাতও একটু বড় হয়ে চলে এলো শহরে,",
  "start": 92.25,
  "end": 94.63,
  "startFrame": 2768,
  "endFrame": 2839
 },
 {
  "i": 26,
  "text": "সকালে ক্লাস,",
  "start": 94.63,
  "end": 95.47,
  "startFrame": 2839,
  "endFrame": 2864
 },
 {
  "i": 26,
  "text": "আর রাতে পার্টটাইম কাজ।",
  "start": 95.47,
  "end": 97.01,
  "startFrame": 2864,
  "endFrame": 2910
 },
 {
  "i": 27,
  "text": "আর মিম গ্রামে মায়ের কাছে থেকে পড়তো।",
  "start": 97.75,
  "end": 99.94,
  "startFrame": 2932,
  "endFrame": 2998
 },
 {
  "i": 28,
  "text": "নম্বর পেলে,",
  "start": 100.71,
  "end": 101.48,
  "startFrame": 3021,
  "endFrame": 3044
 },
 {
  "i": 28,
  "text": "সবার আগে মাকে দেখাতো।",
  "start": 101.48,
  "end": 102.95,
  "startFrame": 3044,
  "endFrame": 3088
 },
 {
  "i": 29,
  "text": "তিনজনেই জানতো,",
  "start": 103.69,
  "end": 104.58,
  "startFrame": 3111,
  "endFrame": 3137
 },
 {
  "i": 29,
  "text": "কোনো একজন থেমে গেলে,",
  "start": 104.58,
  "end": 105.851,
  "startFrame": 3137,
  "endFrame": 3176
 },
 {
  "i": 29,
  "text": "বাকিদের কাঁধে ভার বাড়বে।",
  "start": 105.851,
  "end": 107.44,
  "startFrame": 3176,
  "endFrame": 3223
 },
 {
  "i": 30,
  "text": "কয়েক বছর এভাবেই কেটে গেলো।",
  "start": 108.19,
  "end": 109.97,
  "startFrame": 3246,
  "endFrame": 3299
 },
 {
  "i": 31,
  "text": "নুসরাত চাকরি পেলো ব্যাংকে।",
  "start": 110.75,
  "end": 112.44,
  "startFrame": 3322,
  "endFrame": 3373
 },
 {
  "i": 32,
  "text": "রাহাত ইঞ্জিনিয়ার হয়ে",
  "start": 113.19,
  "end": 114.455,
  "startFrame": 3396,
  "endFrame": 3434
 },
 {
  "i": 32,
  "text": "ঢুকলো একটা কোম্পানিতে।",
  "start": 114.455,
  "end": 115.72,
  "startFrame": 3434,
  "endFrame": 3472
 },
 {
  "i": 33,
  "text": "আর মিম ভর্তি হলো মেডিকেলে।",
  "start": 116.5,
  "end": 118.25,
  "startFrame": 3495,
  "endFrame": 3548
 },
 {
  "i": 34,
  "text": "প্রথম বেতনের দিন,",
  "start": 119.07,
  "end": 120.187,
  "startFrame": 3572,
  "endFrame": 3606
 },
 {
  "i": 34,
  "text": "নুসরাত ফোন করে বললো, মা,",
  "start": 120.187,
  "end": 121.764,
  "startFrame": 3606,
  "endFrame": 3653
 },
 {
  "i": 34,
  "text": "এবার তুমি বিশ্রাম নাও।",
  "start": 121.764,
  "end": 123.21,
  "startFrame": 3653,
  "endFrame": 3696
 },
 {
  "i": 35,
  "text": "মা হেসে বললো, আরে,",
  "start": 123.97,
  "end": 125.346,
  "startFrame": 3719,
  "endFrame": 3760
 },
 {
  "i": 35,
  "text": "আমি তো ঠিকই আছি।",
  "start": 125.346,
  "end": 126.57,
  "startFrame": 3760,
  "endFrame": 3797
 },
 {
  "i": 36,
  "text": "কিন্তু ফোনের ওপাশে,",
  "start": 127.33,
  "end": 128.514,
  "startFrame": 3820,
  "endFrame": 3855
 },
 {
  "i": 36,
  "text": "মায়ের গলা কাঁপছিলো।",
  "start": 128.514,
  "end": 129.76,
  "startFrame": 3855,
  "endFrame": 3893
 },
 {
  "i": 37,
  "text": "এক শুক্রবার সকালে,",
  "start": 130.53,
  "end": 131.676,
  "startFrame": 3916,
  "endFrame": 3950
 },
 {
  "i": 37,
  "text": "তিন ভাইবোন একসাথে গ্রামে ফিরলো।",
  "start": 131.676,
  "end": 133.65,
  "startFrame": 3950,
  "endFrame": 4010
 },
 {
  "i": 38,
  "text": "উঠানে দাঁড়িয়ে ওরা দেখলো,",
  "start": 134.39,
  "end": 136.094,
  "startFrame": 4032,
  "endFrame": 4083
 },
 {
  "i": 38,
  "text": "মা তখনো সেলাই করছে।",
  "start": 136.094,
  "end": 137.34,
  "startFrame": 4083,
  "endFrame": 4120
 },
 {
  "i": 39,
  "text": "রাহাত মায়ের হাত",
  "start": 138.13,
  "end": 139.024,
  "startFrame": 4144,
  "endFrame": 4171
 },
 {
  "i": 39,
  "text": "থেকে সুই-সুতো সরিয়ে নিয়ে,",
  "start": 139.024,
  "end": 140.533,
  "startFrame": 4171,
  "endFrame": 4216
 },
 {
  "i": 39,
  "text": "একটা চাবি তুলে দিলো।",
  "start": 140.533,
  "end": 141.65,
  "startFrame": 4216,
  "endFrame": 4250
 },
 {
  "i": 40,
  "text": "নতুন ঘরের চাবি।",
  "start": 142.42,
  "end": 143.68,
  "startFrame": 4273,
  "endFrame": 4310
 },
 {
  "i": 41,
  "text": "ছাদওয়ালা পাকা ঘর,",
  "start": 144.43,
  "end": 145.561,
  "startFrame": 4333,
  "endFrame": 4367
 },
 {
  "i": 41,
  "text": "যেখানে বৃষ্টির জল আর চুঁইয়ে পড়বে না।",
  "start": 145.561,
  "end": 147.95,
  "startFrame": 4367,
  "endFrame": 4438
 },
 {
  "i": 42,
  "text": "মা অনেকক্ষণ চুপ করে রইলো।",
  "start": 148.71,
  "end": 150.38,
  "startFrame": 4461,
  "endFrame": 4511
 },
 {
  "i": 43,
  "text": "তারপর বললো,",
  "start": 151.14,
  "end": 151.91,
  "startFrame": 4534,
  "endFrame": 4557
 },
 {
  "i": 43,
  "text": "আমি তো কিছুই করিনি রে।",
  "start": 151.91,
  "end": 153.45,
  "startFrame": 4557,
  "endFrame": 4604
 },
 {
  "i": 44,
  "text": "নুসরাত মায়ের হাত ধরে বললো,",
  "start": 154.21,
  "end": 155.982,
  "startFrame": 4626,
  "endFrame": 4679
 },
 {
  "i": 44,
  "text": "মা, তুমি আমাদের সবকিছু ছিলে।",
  "start": 155.982,
  "end": 157.82,
  "startFrame": 4679,
  "endFrame": 4735
 },
 {
  "i": 45,
  "text": "তোমার জন্যই আমরা আজ",
  "start": 158.58,
  "end": 159.86,
  "startFrame": 4757,
  "endFrame": 4796
 },
 {
  "i": 45,
  "text": "এতটা এগোতে পেরেছি,",
  "start": 159.86,
  "end": 161.073,
  "startFrame": 4796,
  "endFrame": 4832
 },
 {
  "i": 45,
  "text": "তুমি অনেক কষ্ট করেছো।",
  "start": 161.073,
  "end": 162.45,
  "startFrame": 4832,
  "endFrame": 4874
 },
 {
  "i": 46,
  "text": "এবার তোমার ছুটি।",
  "start": 163.22,
  "end": 164.36,
  "startFrame": 4897,
  "endFrame": 4931
 },
 {
  "i": 47,
  "text": "সেই রাতে বৃষ্টি নামলো।",
  "start": 165.11,
  "end": 166.63,
  "startFrame": 4953,
  "endFrame": 4999
 },
 {
  "i": 48,

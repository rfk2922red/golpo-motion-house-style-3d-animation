  { id: 21, a: 3495, b: 3572, light: "golden", place: "town", era: "adult", cast: ["mim"] },
  { id: 22, a: 3572, b: 3719, light: "golden", place: "town", era: "adult", cast: ["nusrat"] },
  { id: 23, a: 3719, b: 3916, light: "golden", place: "village", era: "old", cast: ["mother"], house: "tin" },
  { id: 24, a: 3916, b: 4144, light: "day", place: "road", era: "adult", cast: ["nusrat", "rahat", "mim", "mother"], house: "tin" },
  { id: 25, a: 4144, b: 4626, light: "golden", place: "village", era: "old", cast: ["mother", "nusrat", "rahat", "mim"], house: "pucca" }, // needle insert + key (old 20)
  { id: 26, a: 4626, b: 4953, light: "golden", place: "village", era: "old", cast: ["mother", "nusrat", "rahat", "mim"], house: "pucca" },
  { id: 27, a: 4953, b: 5172, light: "rain", place: "village", era: "old", cast: ["mother", "nusrat", "rahat", "mim"], house: "pucca", rain: true }, // ends on the umbrella
  { id: 28, a: 5172, b: TOTAL, light: "lamp", place: "bedroom", era: "old", cast: ["mother"] },                           // NEW: she falls asleep
];
/** crossfades (frames) at place/time changes; a white 4-frame flash after the hook line */
export const XFADE: Record<number, number> = { 10: 8, 11: 6, 14: 8, 19: 8, 22: 8, 23: 8, 24: 8, 27: 10 }; // 21 (after the caliper) and 28 (the bedroom) are hard cuts
export const FLASH_AT = 66; // just after "বাবা চলে গিয়েছিলো এক বর্ষার রাতে" (ends 2.16 s)
export const shotAt = (f: number) => SHOTS.find((s) => f >= s.a && f < s.b) ?? SHOTS[SHOTS.length - 1];
export const layersAt = (f: number): { id: number; alpha: number }[] => {
  for (const s of SHOTS) {
    const x = XFADE[s.id];
    if (x && f >= s.a - x / 2 && f < s.a + x / 2) return [{ id: s.id - 1, alpha: 1 }, { id: s.id, alpha: (f - (s.a - x / 2) + 1) / (x + 1) }];
  }
  return [{ id: shotAt(f).id, alpha: 1 }];
};


// ---------------- retiming layer ----------------
// The camera/DOF/foreground keys below were authored on a 4500-frame plan ("planned frames"). The real voice-over
// (175.1 s) sets each shot's real length, so every planned frame is mapped linearly inside its shot: PLAN[id] = the
// planned range that shot plays. Round 7 split old shots exactly where the old mapping put those real frames (14/18 are
// old 13, 27 is old 22 cut at the umbrella) and gave the NEW shots their own plan frames: N7 + the real frame.
export const N7 = 10000;
export const PLAN: Record<number, [number, number]> = {
  1: [0, 270], 2: [270, 600], 3: [600, 750], 4: [750, 900], 5: [900, 1080], 6: [1080, 1500], 7: [1500, 1740],
  8: [N7 + 2147, N7 + 2196], 9: [1810, 1890], 10: [1890, 2190], 11: [2190, 2330], 12: [2330, 2450], 13: [2450, 2580],
  14: [2580, 2580 + (179 * 120) / 390], 15: [N7 + 3111, N7 + 3147], 16: [N7 + 3147, N7 + 3183], 17: [N7 + 3183, N7 + 3216],
  18: [2580 + (284 * 120) / 390, 2700], 19: [2700, 2790], 20: [N7 + 3396, N7 + 3495], 21: [2880, 3060], 22: [3060, 3210],
  23: [3210, 3360], 24: [3360, 3690], 25: [3690, 3900], 26: [3900, 4050], 27: [4050, 4050 + (219 * 450) / 301], 28: [N7 + 5172, N7 + TOTAL],
};
/** real frame f of shot id -> planned frame the keys were written in */
export const toPlan = (id: number, f: number) => {
  const s = SHOTS[id - 1], [pa, pb] = PLAN[id];
  return pa + ((f - s.a) * (pb - pa)) / Math.max(1, s.b - s.a);
};
/** planned frame (any shot) -> real frame */
export const toActual = (pf: number) => {
  for (const id of Object.keys(PLAN).map(Number)) {
    const [pa, pb] = PLAN[id], s = SHOTS[id - 1];
    if (pf >= pa && pf < pb) return s.a + ((pf - pa) * (s.b - s.a)) / (pb - pa);
  }
  return SHOTS[SHOTS.length - 1].b;
};

// ---------------- camera ----------------
export type Cam = { pos: V3; look: V3; fov: number; roll: number };
type Shot = Partial<Cam> & { pos: V3; look: V3 };
type Key = { f: number; dur?: number; cut?: boolean; s: (f: number) => Shot };
export const glide = (u: number) => { const x = clamp01(u); return x * x * x * (x * (6 * x - 15) + 10); };
const mix = (a: Cam, b: Cam, k: number): Cam => ({
  pos: a.pos.map((v, i) => v + (b.pos[i] - v) * k) as V3, look: a.look.map((v, i) => v + (b.look[i] - v) * k) as V3,
  fov: a.fov + (b.fov - a.fov) * k, roll: a.roll + (b.roll - a.roll) * k,
});
const full = (c: Shot): Cam => ({ fov: 40, roll: 0, ...c });
const run = (keys: Key[], f: number) => {
  let cur = full(keys[0].s(f));
  for (let i = 1; i < keys.length; i++) {
    const k = keys[i];
    if (f < k.f) break;
    cur = k.cut ? full(k.s(f)) : mix(cur, full(k.s(f)), glide((f - k.f) / (k.dur ?? 24)));
  }
  return cur;
};
const T = (f: number) => f / FPS;
const pushK = (f: number, f0: number, rate: number, punch = 0, n = 35) => {
  const x = Math.max(0, f - f0);
  let s = rate * x;
  if (punch > rate) for (let i = 0; i < Math.min(x, n); i++) s += (punch - rate) * Math.max(0, Math.min(1, (i + 0.5) / 8, (n - i - 0.5) / 8));
  return Math.exp(-s);
};
const dolly = (pos: V3, look: V3, k: number, rest: Partial<Cam> = {}): Shot =>
  ({ pos: [look[0] + (pos[0] - look[0]) * k, look[1] + (pos[1] - look[1]) * k, look[2] + (pos[2] - look[2]) * k], look, ...rest });
const zoom = (pos: V3, look: V3, fov: number, k: number, rest: Partial<Cam> = {}): Shot =>
  ({ pos, look, fov: (360 / Math.PI) * Math.atan(Math.tan((fov * Math.PI) / 360) * k), ...rest });
const add = (p: V3, d: V3): V3 => [p[0] + d[0], p[1] + d[1], p[2] + d[2]];
/** a framing relative to an anchor: camera offset c and look offset l from the anchor a */
const rel = (a: V3, c: V3, l: V3, f0: number, rate: number, rest: Partial<Cam> = {}, punch = 0, n = 35) =>
  (f: number) => dolly(add(a, c), add(a, l), pushK(f, f0, rate, punch, n), rest);


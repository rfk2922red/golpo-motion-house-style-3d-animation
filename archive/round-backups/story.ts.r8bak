const S20o = rel(OFFICE, [1.0, 1.3, 2.1], [-0.05, 1.0, -0.35], N7 + 3396, 0.0025, { fov: 38 });      // Rahat at the CAD screen
const S20i = rel(INS20, [0.04, 0.06, 0.7], [0, 0, 0], N7 + 3444, 0.0025, { fov: 38 });               // the caliper on the piston
const S25n = rel(NEEDLE, [0.03, 0.05, 0.68], [0, 0, 0], 3690, 0.005, { fov: 38 });                   // the needle taken from her
/** the bedroom: wide (bed, lamp, window) -> a slow push to head-and-shoulders (~2 m: her head ~1/3 of the frame width) */
const S28b = (f: number): Shot => {
  const k = glide(clamp01((f - (N7 + 5172)) / 142)), w = { pos: add(BEDROOM, [-0.45, 1.6, 3.0]), look: add(BEDROOM, [-0.45, 0.95, -0.8]), fov: 54 }; // bed, lamp and window
  const c = { pos: add(BED_HEAD, [0.6, 0.55, 1.85]), look: add(BED_HEAD, [0.2, -0.02, 0]), fov: 40 };
  return { pos: w.pos.map((v, i) => v + (c.pos[i] - v) * k) as V3, look: w.look.map((v, i) => v + (c.look[i] - v) * k) as V3, fov: w.fov + (c.fov - w.fov) * k };
};            // foot of the bed -> her face


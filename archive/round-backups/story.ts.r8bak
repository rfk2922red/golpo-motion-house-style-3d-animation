  22: [{ f: 3060, s: S17a }, { f: 3130, dur: 30, s: S17b }],
  23: [{ f: 3210, s: S18a }, { f: 3290, dur: 26, s: S18b }],
  24: [{ f: 3360, s: S19a }, { f: 3560, cut: true, s: S19b }],
  25: [{ f: 3690, s: S25n }, { f: 3713, cut: true, s: S20a }, { f: 3780, cut: true, s: S20b }],
  26: [{ f: 3900, s: S20c }], // hug: Nusrat's "তুমি আমাদের সবকিছু ছিলে" (wide, pulling back)
  27: [{ f: 4050, s: S21a }, { f: 4280, dur: 30, s: S21b }],
  28: [{ f: N7 + 5172, s: S28b }],
};

// impact kicks (flip sign every frame, decay in 7 f): rain drops in the pot, the bus passing, the key placed in her hand
const KICKS: [number, number][] = [
  [28.4, 0.35], [30.1, 0.35], [32.0, 0.35], // drips in the pot ("পাতিল পেতে দিতো", 27.2-30.6 s)
  [82.6, 0.7],                               // the bus pulls away ("বললো, ভালো কোরে পোড়িস মা" ends 82.56 s)
  [141.1, 1.0],                              // the key lands in her palm ("একটা চাবি তুলে দিলো" ends 141.4 s)
];
export const kickAt = (t: number) => {
  let a = 0;
  for (const [t0, g] of KICKS) {
    const n = Math.floor((t - t0) * FPS + 1e-6);
    if (n >= 0 && n < 7) a += g * (n % 2 ? -1 : 1) * (1 - n / 7) ** 1.5;
  }
  return a;
};
export const camAt = (id: number, f: number): Cam => {
  const c = run(CAMS[id], toPlan(id, f)), a = kickAt(T(f));
  if (!a) return c;
  const d: V3 = [c.look[0] - c.pos[0], c.look[1] - c.pos[1], c.look[2] - c.pos[2]];
  const L = Math.hypot(...d), h = Math.hypot(d[0], d[2]) || 1;
  const m = (3 / 640) * Math.tan((c.fov * Math.PI) / 360) * L * a;
  return { ...c, look: [c.look[0] - (d[2] / h) * m, c.look[1] + 0.6 * m, c.look[2] + (d[0] / h) * m], roll: c.roll + a * 0.004 };
};
export const keyEnd = (id: number, f: number) => {
  const pf = toPlan(id, f);
  let e = 0;
  for (const k of CAMS[id]) if (pf >= k.f) e = k.f + (k.cut ? 0 : k.dur ?? 24);
  return Math.max(f, toActual(Math.max(pf, e)));
};

// ---------------- lens: depth of field + foreground framing ----------------
export type Dof = { f: number; dur?: number; cInf: number; focus?: (f: number) => V3 };
export const DOF: Dof[] = [
  { f: 0, cInf: 15 },                  // hook CU on the peg (focus = look)
  { f: 40, dur: 36, cInf: 0 },         // pull-back wide stays sharp
  { f: 150, dur: 24, cInf: 12 },       // doorway push-in on the family
  { f: 270, cInf: 0 },                 // village aerial (establishing)
  { f: 345, cInf: 10 },                // courtyard MS
  { f: 374, cInf: 11 },                // Fatema

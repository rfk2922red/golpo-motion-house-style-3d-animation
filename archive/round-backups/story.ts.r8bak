  14: [{ f: 2580, s: S13a }],
  15: [{ f: N7 + 3111, s: S15n }],
  16: [{ f: N7 + 3147, s: S16r }],
  17: [{ f: N7 + 3183, s: S17m }],
  18: [{ f: 2580, s: S13a }],
  19: [{ f: 2700, s: S14a }],
  20: [{ f: N7 + 3396, s: S20o }, { f: N7 + 3444, cut: true, s: S20i }],

// "মায়ের অবসর" (Mother's Rest): shot plan, camera grammar, lens and foreground for the Bangla short.
// Derived from the bridge template: same camera grammar (smootherstep glides 18-40 f, hard cuts on big jumps, every hold
// creeps, 7 f impact kicks, rolls 4-5 deg). The bridge physics (march, bounce, snap) is gone; the story is carried by
// SHOTS (place + light + cast) and the cameras. Frame numbers are ESTIMATES (150 s at 30 fps): retime every `a`/`b`/key
// from words.json once the Bangla voice-over exists (see TIMING in BUILD_NOTES.md).
export const FPS = 30;
export const TOTAL = 5314; // 177.13 s: the voice-over + a 2 s rain tail for the bed scene (mix_v2.wav), 30 fps
export type V3 = [number, number, number];

export const clamp01 = (x: number) => Math.max(0, Math.min(1, x));
export const smooth = (x: number) => { const u = clamp01(x); return u * u * (3 - 2 * u); };
export const easeOut = (u: number) => 1 - (1 - clamp01(u)) ** 4;

// ---------------- world layout (metres, y up, ground y = 0) ----------------
// Village: the hut at the origin, door facing +z, courtyard in front, pond to the left, a kaccha path along x = 3 to the
// bus stop under the banyan. Hut interior is a separate small set far away so cameras never see the outside.
// Town: another far set (street, mess house, bank, rooftop, medical gate) along x = 200.
export const HUT: V3 = [0, 0, 0];
export const COURT: V3 = [0, 0, 6];
export const POND: V3 = [-12, 0, 10];
export const DHEKI: V3 = [-4.5, 0, 5.5];
export const WELL: V3 = [14, 0, 14];          // the neighbour's well (shot 4)
export const BUS_STOP: V3 = [3, 0, 70];
export const INT: V3 = [-100, 0, 0];          // hut interior, 4 x 3.5 m, table at INT, rice tin on the shelf at +x
export const TABLE: V3 = [INT[0], 0.45, INT[2]];
export const TOWN: V3 = [200, 0, 0];
export const STREET: V3 = [200, 0, 20];
export const MESS: V3 = [212, 0, 38];
export const BANK: V3 = [190, 0, 70];
export const ROOF: V3 = [222, 11, 40];
export const MED_GATE: V3 = [170, 0, 110];
export const S2_POS = { porch: [1.6, 0.45, 2.75] as V3, rahat: [2.6, 0, 5.2] as V3 };
// round 7 sets, far from the rest: the bangle stall, the computer shop, Rahat's office, the bedroom of the new house
export const STALL: V3 = [-200, 0, 0];
export const SHOP: V3 = [300, 0, 40];
export const OFFICE: V3 = [300, 0, 0];
export const BEDROOM: V3 = [-100, 0, 40];
export const NEWHOUSE: V3 = [0, 0, 0];       // the pucca house is the same hut footprint, rebuilt (scenes 19-20)

// ---------------- shots ----------------
export type Light = "day" | "golden" | "rain" | "lamp";
export type Place = "village" | "interior" | "town" | "road" | "stall" | "shop" | "office" | "bedroom";
export type Cast = "mother" | "nusrat" | "rahat" | "mim" | "father" | "seller" | "none";
export type ShotDef = {
  id: number; a: number; b: number; light: Light; place: Place;
  era: "child" | "teen" | "adult" | "old"; // costume set for the cast (cast.ts reads it)
  cast: Cast[]; house?: "tin" | "pucca"; rain?: boolean;
};

  { f: 600, cInf: 12 },                // dheki
  { f: 750, cInf: 8 },                 // well
  { f: 900, cInf: 10 },                // sewing MS
  { f: 935, dur: 20, cInf: 15 },      // the drip
  { f: 1080, cInf: 15 },               // rice tin CU
  { f: 1170, cInf: 10 },               // plates MS
  { f: 1350, dur: 24, cInf: 14 },      // Nusrat's eyes
  { f: 1500, cInf: 8 },                // study MS
  { f: 1620, dur: 30, cInf: 12 },
  { f: 1740, cInf: 14 },               // bangles insert
  { f: 1890, cInf: 0 },                // bus stop wide
  { f: 1982, cInf: 16 },               // the anchal-money hands
  { f: 2087, cInf: 11 },               // two-shot, crying
  { f: 2152, cInf: 0 },                // long lens wide, mother shrinking
  { f: 2190, cInf: 10 },
  { f: 2330, cInf: 8 },
  { f: 2450, cInf: 7 },
  { f: 2580, cInf: 6 },
  { f: 2700, cInf: 11 },
  { f: 2790, cInf: 11 },
  { f: 2880, cInf: 0 },
  { f: 2975, dur: 26, cInf: 12 },
  { f: 3060, cInf: 5 },
  { f: 3130, dur: 30, cInf: 12 },
  { f: 3210, cInf: 8 },
  { f: 3290, dur: 26, cInf: 14 },
  { f: 3360, cInf: 0 },                // return walk (wide, sharp)
  { f: 3690, cInf: 16 },               // the needle hands
  { f: 3713, cInf: 16 },               // key CU
  { f: 3780, cInf: 12 },
  { f: 3900, dur: 40, cInf: 0 },
  { f: 4050, cInf: 0 },                // callback wide
  { f: 4280, dur: 30, cInf: 14 },      // peg CU
  // round 7 shots (N7 + real frames)
  { f: N7 + 2147, cInf: 9 },           // stall two-shot
  { f: N7 + 2172, cInf: 16 },          // hands on the counter
  { f: N7 + 3111, cInf: 13 },          // Nusrat writing
  { f: N7 + 3147, cInf: 13 },          // Rahat at the shop
  { f: N7 + 3183, cInf: 13 },          // Mim at the lamp
  { f: N7 + 3396, cInf: 9 },           // the office
  { f: N7 + 3444, cInf: 16 },          // the caliper
  { f: N7 + 5172, cInf: 10 },          // the bed
];
export const dofAt = (rf: number) => {
  const f = toPlan(shotAt(rf).id, rf); // DOF keys are in planned frames
  let i = 0; while (i + 1 < DOF.length && f >= DOF[i + 1].f) i++;
  const d = DOF[i], p = DOF[Math.max(0, i - 1)];
  const k = d.dur ? Math.min(1, (f - d.f) / d.dur) : 1;
  return { cInf: p.cInf + (d.cInf - p.cInf) * k, focus: d.focus };
};
export const focusAt = (id: number, f: number): V3 => {
  const d = dofAt(f);
  return d.focus ? d.focus(f) : camAt(id, f).look;
};

// near framing objects (build.ts prop() kit names; Bangladesh kit is built in build.ts, see BUILD_NOTES.md)
export type Fg = { a: number; b: number; kit: string; pos: V3; s?: number; yaw?: number };
const FG_PLANNED: Fg[] = [ // a/b in planned frames (see PLAN); FOREGROUND below holds the real frames
  { a: 40, b: 150, kit: "banana", pos: [4.85, 0, 11.7], s: 1.3, yaw: 0.4 },            // S1 wide: small banana plant just inside the right edge (clear of the door)
  { a: 345, b: 470, kit: "jute_stalks", pos: [-3.4, 0, 9.5], s: 1.6, yaw: 0.2 },       // S2 courtyard MS
  { a: 3360, b: 3560, kit: "paddy", pos: [1.3, 0, 60], s: 0.9, yaw: 0.0 },            // S19 return: paddy at the lens
  { a: 3900, b: 4050, kit: "tulsi", pos: [-1.6, 0, 12.5], s: 0.9, yaw: 0.3 },
];
export const FOREGROUND: Fg[] = FG_PLANNED.map((g) => ({ ...g, a: Math.round(toActual(g.a)), b: Math.round(toActual(g.b)) }));
